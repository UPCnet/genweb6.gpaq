<?xml version="1.0"?>
<registry
  xmlns:i18n="http://xml.zope.org/namespaces/i18n"
  i18n:domain="genweb6.gpaq">

  <records
    interface="Products.CMFPlone.interfaces.IBundleRegistry"
    prefix="plone.bundles/gpaq-bundle">

    <value key="enabled">True</value>
    <value key="compile">True</value>
    <value key="resources">
      <element>gpaq-main</element>
    </value>
    <value key="jscompilation" />
    <value key="csscompilation">++theme++genweb6.gpaq/stylesheets/theme-gpaq.min.css</value>

  </records>

  <!-- folder_contents (pat-structure): plone.icon.contenttype mas portal type normalizado -->
  <record name="plone.icon.contenttype/genweb6-dashboard">
    <field type="plone.registry.field.TextLine">
      <title>GPAQ dashboard</title>
    </field>
    <value key="resource">++plone++bootstrap-icons/bar-chart-fill.svg</value>
  </record>

</registry>
